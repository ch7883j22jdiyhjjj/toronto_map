# CKAN API endpoint
BASE_URL = "https://ckan0.cf.opendata.inter.prod-toronto.ca/api/3/action/package_search"
RESOURCE_URL = "https://ckan0.cf.opendata.inter.prod-toronto.ca/api/3/action/datastore_search"
PACKAGE_URL = "https://ckan0.cf.opendata.inter.prod-toronto.ca/api/3/action/package_show"

def get_resource_id(dataset_name):
    try:
        response = requests.get(f"{BASE_URL}?q={dataset_name}")
        response.raise_for_status()  # This will raise an HTTPError for bad responses (4xx, 5xx)
        
        results = response.json().get("result", {}).get("results", [])
        if results:
            resources = results[0].get("resources", [])
            for resource in resources:
                if resource.get("datastore_active", False):
                    return resource["id"]
        print(f"Failed to find resource ID for dataset '{dataset_name}' - No active datastore resources.")
    
    except requests.exceptions.RequestException as e:
        print(f"Failed to fetch metadata for dataset '{dataset_name}' due to an error: {e}")
    
    return None

def fetch_data(dataset_name, limit=1000):
    try:
        resource_id = get_resource_id(dataset_name)
        if resource_id:
            response = requests.get(f"{RESOURCE_URL}?resource_id={resource_id}&limit={limit}")
            response.raise_for_status()  # Check if the request was successful
            
            return pd.DataFrame(response.json()["result"]["records"])
        else:
            print(f"Failed to fetch data for dataset '{dataset_name}' - No resource ID found.")
    
    except requests.exceptions.RequestException as e:
        print(f"Failed to fetch data for dataset '{dataset_name}' due to an error: {e}")
    
    return pd.DataFrame()

def get_shapefile_url(dataset_id):
    try:
        response = requests.get(PACKAGE_URL, params={"id": dataset_id})
        response.raise_for_status()  # Check for HTTP errors
        
        package = response.json()
        for resource in package["result"]["resources"]:
            if not resource.get("datastore_active", False) and "shp" in resource.get("format", "").lower():
                return resource["url"]
        
        print(f"No shapefile found for dataset '{dataset_id}' - It might not be available or formatted as a shapefile.")
    
    except requests.exceptions.RequestException as e:
        print(f"Failed to fetch shapefile for dataset '{dataset_id}' due to an error: {e}")
    
    return None

