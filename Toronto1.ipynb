####### Fire Stations #######
fire_cluster = MarkerCluster().add_to(toronto_map)
for _, row in fire_stations.iterrows():
    geo = json.loads(row["geometry"])
    lat, lon = geo["coordinates"][1], geo["coordinates"][0]
    folium.Marker(
        location=[lat, lon],
        popup=f"Fire Station: {row['ADDRESS']}",
        icon=folium.Icon(color='red', icon='fire')
    ).add_to(fire_cluster)
    
# Convert from GeoJSON to Shapely geometries if necessary
if isinstance(fire_stations.geometry.iloc[0], str):
    fire_stations['geometry'] = fire_stations['geometry'].apply(lambda x: shape(eval(x)) if isinstance(x, str) else x)

# Parameters
siren_power_db = 130  # dB at 1 meter
threshold_db = 85     # dB, chosen threshold
reference_intensity = 10**-12  # W/m²

# Convert dB to intensity
siren_power_intensity = reference_intensity * 10**(siren_power_db / 10)
threshold_intensity = reference_intensity * 10**(threshold_db / 10)

# Calculate sound radius using inverse square law
fire_stations['sound_radius_m'] = np.sqrt(siren_power_intensity / (4 * np.pi * threshold_intensity))

# Initialize map
mean_lat = fire_stations.geometry.apply(lambda geom: geom.centroid.y).mean()
mean_lon = fire_stations.geometry.apply(lambda geom: geom.centroid.x).mean()

# Prepare data for HeatMap
heat_data = []
for _, row in fire_stations.iterrows():
    lat, lon = row.geometry.centroid.y, row.geometry.centroid.x
    intensity = row['sound_radius_m']  # or any other intensity value you'd prefer
    heat_data.append([lat, lon, intensity])

# Add HeatMap layer with adjusted opacity
HeatMap(heat_data, opacity=0.01).add_to(toronto_map)

