####### EV Charging Stations #######
# Fetch and load the EV charging stations shapefile
ev_shp_url = get_shapefile_url("city-operated-electric-vehicle-charging-station-map")
if ev_shp_url:
    # Load shapefile with GeoPandas (no need to reproject if it's already in WGS84)
    ev_gdf = gpd.read_file(ev_shp_url)
    
    # Check the first few rows to understand the structure
   # print(ev_gdf.head())  # To inspect the data
   # print(ev_gdf.geometry)  # To check geometry type
    # Filter EV charging stations where Level3_6 > 0
    ev_gdf_filtered = ev_gdf[ev_gdf['Level3_6'] > 0]
    
    # Add EV charging stations to the map
    for _, row in ev_gdf_filtered.iterrows():
        geometry = row["geometry"]
        if geometry.geom_type == "Point":
            lat, lon = geometry.y, geometry.x  # Get coordinates from point geometry
            folium.Marker(
                location=[lat, lon],
                popup=f"EV Charging Station: {row.get('Locatio2', 'Unknown')}",
                icon=folium.Icon(icon='fa-plug', prefix='fa', color='beige')
            ).add_to(toronto_map)
        elif geometry.geom_type == "MultiPoint":
            # Iterate through each point in the MultiPoint geometry
            for point in geometry.geoms:
                lat, lon = point.y, point.x  # Extract coordinates from each point
                folium.Marker(
                    location=[lat, lon],
                    popup=f"EV Charging Station: {row.get('Locatio2', 'Unknown')}",
                    icon=folium.Icon(icon='fa-plug', prefix='fa', color='beige')
                ).add_to(toronto_map)
        elif geometry.geom_type in ["Polygon", "MultiPolygon"]:
            # Get centroid for Polygon or MultiPolygon geometries
            centroid = geometry.centroid
            lat, lon = centroid.y, centroid.x
            folium.Marker(
                location=[lat, lon],
                popup=f"EV Charging Station: {row.get('Locatio2', 'Unknown')}",
                icon=folium.Icon(icon='fa-plug', prefix='fa', color='beige')
            ).add_to(toronto_map)

